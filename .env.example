# OpenAI (paid key: https://platform.openai.com/api-keys). When set, it is used instead of Gemini.
OPENAI_API_KEY=
# Optional, default gpt-6-astra. Any OpenAI model with image input works.
# OPENAI_MODEL=gpt-6-astra

# Gemini (free key: https://aistudio.google.com/apikey). Server-only, never exposed to the browser.
GEMINI_API_KEY=
# Any Gemini model that accepts image input. gemini-3.8-flash gives the best results;
# gemini-3.5-flash-lite has a much larger free daily quota.
GEMINI_MODEL=gemini-3.8-flash

# Upstash Redis (free database: https://console.upstash.com). Required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: total generations allowed per day across all visitors (default 400).
# With Gemini, keep it at or below your model's free requests-per-day limit;
# with OpenAI it caps your spend.
# GENERATE_DAILY_CAP=400
